local function calcSize()
    local vpX, vpY = Camera.ViewportSize.X, Camera.ViewportSize.Y
    local land = vpX > vpY
    local w = land and math.clamp(vpX * 0.72, 540, 860) or math.clamp(vpX * 0.94, 350, 490)
    local h = land and math.clamp(vpY * 0.90, 340, 540) or math.clamp(vpY * 0.80, 440, 720)
    return w, h, land
end
