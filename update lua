Heartbeat:Connect(function()
    if not ESPSettings.Enabled then
        for _, d in pairs(ESPdrawings or {}) do resetESPDrawings(d, false) end
        return
    end
    local now = tick()
    if now - lastESPRender < espFrameInterval then return end
    lastESPRender = now
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then updateESPPlayer(player) end
    end
    for player, d in pairs(ESPdrawings or {}) do
        if not player.Parent or not player.Character then
            cleanupESPDrawings(d)
            ESPdrawings[player] = nil
        end
    end
end)

