-- Helper: ripple
local function ripple(parent, x, y)
    local r = Instance.new("Frame")
    r.BackgroundColor3 = Color3.fromRGB(255,120,200)
    r.BackgroundTransparency = 0.4
    r.BorderSizePixel = 0
    r.Size = UDim2.new(0,0,0,0)
    r.Position = UDim2.new(0, x, 0, y)
    r.ZIndex = 50
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1,0); c.Parent = r
    r.Parent = parent
    local t = TweenService:Create(r, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 220, 0, 220),
        Position = UDim2.new(0, x-110, 0, y-110),
        BackgroundTransparency = 1
    }); t:Play()
    t.Completed:Connect(function() r:Destroy() end)
end

-- Helper: hover scale
local function addHoverScale(btn, scale)
    scale = scale or 1.02
    local orig = btn.Size
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(orig.X.Scale*scale, orig.X.Offset*scale, orig.Y.Scale*scale, orig.Y.Offset*scale)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = orig}):Play()
    end)
end

