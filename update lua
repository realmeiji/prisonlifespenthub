            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > ESPState.MaxDistance then
                for _, d in pairs(o) do d.Visible = false end
                continue
            end
            local pos, on = WorldToViewportPoint(Camera, hrp.Position)
            if not on then
                for _, d in pairs(o) do d.Visible = false end
                continue
            end
            local head = WorldToViewportPoint(Camera, hrp.Position + Vector3.new(0, 3, 0))
            local foot = WorldToViewportPoint(Camera, hrp.Position - Vector3.new(0, 3, 0))
            local h = math.abs(head.Y - foot.Y)
