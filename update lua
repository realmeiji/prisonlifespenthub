local function cleanupESPDrawings(d)
    for _, obj in pairs(d) do
        if type(obj) == "table" then
            for _, sub in pairs(obj) do
                if sub and sub.Remove then sub:Remove() end
            end
        elseif obj and obj.Remove then obj:Remove() end
    end
end

local function resetESPDrawings(d, visible)
    d.box.Visible = visible
    d.name.Visible = visible
    d.healthBar.Visible = visible
    d.healthBg.Visible = visible
    d.distance.Visible = visible
    d.tracer.Visible = visible
    for _, line in pairs(d.skeletonLines) do line.Visible = visible end
end

local function getESPColor(player)
    if ESPSettings.TeamColor and player.Team then
        return player.Team.TeamColor.Color
    end
    return ESPSettings.Color
end

local HighlightCache = {}

local function updateHighlight(player, char, enabled)
    if not ESPSettings.Highlight or not enabled then
        if HighlightCache[player] then
            HighlightCache[player]:Destroy()
            HighlightCache[player] = nil
        end
        return
    end
    if not HighlightCache[player] then
        local hl = Instance.new("Highlight")
        hl.Name = "SpentHubHL"
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0.2
        hl.Parent = char
        HighlightCache[player] = hl
    end
    local hl = HighlightCache[player]
    hl.Adornee = char
    hl.FillColor = getESPColor(player)
    hl.OutlineColor = getESPColor(player)
end

local function updateESPPlayer(player)
    local d = ESPDrawings[player]
    if not d then d = createESPDrawings(); ESPDrawings[player] = d end
    local char = player.Character
    if not char then resetESPDrawings(d, false); updateHighlight(player, nil, false); return end
    if ESPSettings.TeamCheck and player.Team == LocalPlayer.Team then resetESPDrawings(d, false); updateHighlight(player, char, false); return end
    if IsWhitelisted(player) then resetESPDrawings(d, false); updateHighlight(player, char, false); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not hrp or not hum or hum.Health <= 0 or not head then resetESPDrawings(d, false); updateHighlight(player, char, false); return end
    local camPos = Camera.CFrame.Position
    local dist = (hrp.Position - camPos).Magnitude
    if dist > ESPSettings.MaxDistance then resetESPDrawings(d, false); updateHighlight(player, char, false); return end
    local topScreen, topOn = WorldToViewportPoint(Camera, head.Position + Vector3.new(0, 0.5, 0))
    local bottomScreen, bottomOn = WorldToViewportPoint(Camera, hrp.Position - Vector3.new(0, 3, 0))
    if not topOn or not bottomOn then resetESPDrawings(d, false); updateHighlight(player, char, false); return end
    local height = math.abs(topScreen.Y - bottomScreen.Y)
    local width = height * 0.6
    local x = topScreen.X - width / 2
    local y = topScreen.Y
    if height <= 0 or height > 5000 then resetESPDrawings(d, false); updateHighlight(player, char, false); return end

    local color = getESPColor(player)

    updateHighlight(player, char, true)

    d.box.Visible = ESPSettings.Box
    d.box.Color = color
    d.box.Thickness = 1
    d.box.Filled = false
    d.box.Size = Vector2.new(width, height)
    d.box.Position = Vector2.new(x, y)
    d.name.Visible = ESPSettings.Name
    d.name.Color = color
    d.name.Size = 13
    d.name.Center = true
    d.name.Outline = true
    d.name.OutlineColor = Color3.fromRGB(0, 0, 0)
    d.name.Text = player.Name
    d.name.Position = Vector2.new(topScreen.X, y - 18)
    local hp = hum.Health / hum.MaxHealth
    d.healthBg.Visible = ESPSettings.Health
    d.healthBg.Color = Color3.fromRGB(0, 0, 0)
    d.healthBg.Thickness = 1
    d.healthBg.Filled = true
    d.healthBg.Size = Vector2.new(5, height + 2)
    d.healthBg.Position = Vector2.new(x - 8, y - 1)
    d.healthBar.Visible = ESPSettings.Health
    d.healthBar.Color = Color3.fromRGB(255, 105, 180)
    d.healthBar.Thickness = 1
    d.healthBar.Filled = true
    d.healthBar.Size = Vector2.new(3, height * hp)
    d.healthBar.Position = Vector2.new(x - 7, y + height * (1 - hp))
    d.distance.Visible = ESPSettings.Distance
    d.distance.Color = color
    d.distance.Size = 11
    d.distance.Center = true
    d.distance.Outline = true
    d.distance.OutlineColor = Color3.fromRGB(0, 0, 0)
    d.distance.Text = math.floor(dist) .. "m"
    d.distance.Position = Vector2.new(topScreen.X, y + height + 2)
    if ESPSettings.Tracer then
        d.tracer.Visible = true
        d.tracer.Color = color
        d.tracer.Thickness = 1
        d.tracer.Transparency = 0.5
        d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        d.tracer.To = Vector2.new(topScreen.X, topScreen.Y)
    else d.tracer.Visible = false end
    if ESPSettings.Skeleton then
        local bones = {
            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
            {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
            {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
            {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
        }
        for i, pair in ipairs(bones) do
            if not d.skeletonLines[i] then d.skeletonLines[i] = Drawing.new("Line") end
            local line = d.skeletonLines[i]
            local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
            if a and b then
                local aPos, aOn = WorldToViewportPoint(Camera, a.Position)
                local bPos, bOn = WorldToViewportPoint(Camera, b.Position)
                if aOn and bOn then
                    line.Visible = true
                    line.Color = color
                    line.Thickness = 1
                    line.Transparency = 0.3
                    line.From = Vector2.new(aPos.X, aPos.Y)
                    line.To = Vector2.new(bPos.X, bPos.Y)
                else line.Visible = false end
            else line.Visible = false end
        end
    else for _, line in pairs(d.skeletonLines) do line.Visible = false end end
end

