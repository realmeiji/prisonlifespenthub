local function calcSize()
    local vpX, vpY = Camera.ViewportSize.X, Camera.ViewportSize.Y
    local land = vpX > vpY
    local w = land and math.clamp(vpX * 0.75, 560, 900) or math.clamp(vpX * 0.95, 360, 500)
    local h = land and math.clamp(vpY * 0.92, 340, 560) or math.clamp(vpY * 0.82, 460, 740)
    return w, h, land
end
