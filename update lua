    local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(255,100,200); s.Transparency = 1; s.Parent = btn
    addHoverScale(btn, 1.02)
    btn.MouseEnter:Connect(function() TweenService:Create(s, TweenInfo.new(0.2), {Transparency = 0.3}):Play() end)
