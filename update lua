    knob.BorderSizePixel = 0
    knob.ZIndex = 10
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local drag = false
    local function upd(x)
        local p = math.clamp((x - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
