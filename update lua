local function CreateTab(name, icon)
    local btn = New("TextButton", {
        Text = "  " .. icon .. "  " .. name,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.Sub,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -8, 0, 34),
        Position = UDim2.new(0, 4, 0, 4 + (#Tabs * 38)),
        Parent = Sidebar,
    })
    Corner(btn, 8)
    local indicator = New("Frame", {
        Size = UDim2.new(0, 3, 0, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = btn,
    })
    Corner(indicator, 2)
    Gradient(indicator, Theme.Accent, Theme.Accent2, 90)

    local container = New("Frame", {
        Name = "Tab_" .. name,
        Size = UDim2.new(1, -16, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = Content,
    })
    New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = container})

    local data = {Btn = btn, Container = container, Indicator = indicator, Name = name}
    table.insert(Tabs, data)

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Container.Visible = false
            TweenService:Create(t.Btn, TweenInfo.new(0.18), {BackgroundTransparency = 1, TextColor3 = Theme.Sub}):Play()
            TweenService:Create(t.Indicator, TweenInfo.new(0.18), {Size = UDim2.new(0, 3, 0, 0)}):Play()
        end
        container.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundTransparency = 0.82, TextColor3 = Theme.Text}):Play()
        TweenService:Create(indicator, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.new(0, 3, 0, 22)}):Play()
        ActiveTab = data
    end)

    btn.MouseEnter:Connect(function()
        if ActiveTab ~= data then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.9, TextColor3 = Theme.Text}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= data then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 1, TextColor3 = Theme.Sub}):Play()
        end
    end)

    return container, data
end

