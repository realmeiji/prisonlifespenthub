local function removeESP(player)
    if esp_objects[player] then
        for _,v in pairs(esp_objects[player]) do pcall(function() v:Remove() end) end
        esp_objects[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

local function getTeamColor(player)
    local team = player.Team
    if team then return team.TeamColor.Color end
    return SilentAimSettings.ESPColor
end

local function updateESP()
    if not SilentAimSettings.ESPEnabled then
        for _, objs in pairs(esp_objects) do for _,v in pairs(objs) do v.Visible = false end end
        return
    end
    for _, player in ipairs(GetPlayers(Players)) do
        if player == LocalPlayer or isWhitelisted(player) then
            if esp_objects[player] then for _,v in pairs(esp_objects[player]) do v.Visible = false end end
            continue
        end
        if not esp_objects[player] then createESP(player) end
        local objs = esp_objects[player]
        local char = player.Character
        local color = SilentAimSettings.ESPTeamColor and getTeamColor(player) or SilentAimSettings.ESPColor
        objs.box.Color = color
        objs.tracer.Color = color
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local hrp = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")
            local pos, onscreen = WorldToViewportPoint(Camera, hrp.Position)
            local headPos = WorldToViewportPoint(Camera, (head and head.Position or hrp.Position + Vector3.new(0,2,0)))
            if onscreen then
                local height = math.abs(pos.Y - headPos.Y) * 1.2
                local width = height / 2
                objs.box.Size = Vector2.new(width, height)
                objs.box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                objs.box.Visible = SilentAimSettings.ESPBox
                objs.name.Text = player.Name
                objs.name.Position = Vector2.new(pos.X, pos.Y - height/2 - 16)
                objs.name.Visible = SilentAimSettings.ESPName
                local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                objs.tracer.From = screenCenter
                objs.tracer.To = Vector2.new(pos.X, pos.Y + height/2)
                objs.tracer.Visible = SilentAimSettings.ESPTracer
                local hp = char.Humanoid.Health / char.Humanoid.MaxHealth
                objs.health.Size = Vector2.new(2, height * hp)
                objs.health.Position = Vector2.new(pos.X - width/2 - 5, pos.Y - height/2 + height*(1-hp))
                objs.health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                objs.health.Visible = SilentAimSettings.ESPHealth
                local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
                objs.dist.Text = string.format("[%d studs]", math.floor(distance))
                objs.dist.Position = Vector2.new(pos.X, pos.Y + height/2 + 2)
                objs.dist.Visible = SilentAimSettings.ESPDistance
            else
                for _,v in pairs(objs) do v.Visible = false end
            end
        else
            for _,v in pairs(objs) do v.Visible = false end
        end
    end
end

